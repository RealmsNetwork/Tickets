# Required: create an application/bot in the Discord Developer Portal.
DISCORD_TOKEN=replace_me
DISCORD_CLIENT_ID=replace_me
# Optional: makes command deployment guild-scoped while testing.
DISCORD_DEV_GUILD_ID=
# Optional: override file locations.
TICKETS_CONFIG=./config/settings.json
TICKETS_DATABASE=./data/tickets.sqlite
# Optional AI ticket summaries. Feature must also be enabled in settings.json.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional authenticated dashboard. Leave blank to disable the HTTP dashboard.
DASHBOARD_SECRET=
DASHBOARD_PORT=8787
