        "logsChannelId": "",
        "supportRoleIds": [],
        "requiredRoleIds": [],
        "questions": [
          { "label": "What do you need help with?", "required": true, "style": "paragraph" }
        ]
      },
      {
        "id": "technical",
        "name": "Technical Support",
        "description": "Report a technical problem",
        "emoji": "🛠️",
        "parentCategoryId": "",
        "logsChannelId": "",
        "supportRoleIds": [],
        "requiredRoleIds": [],
        "questions": [
          { "label": "What happened? Include any error message.", "required": true, "style": "paragraph" },
          { "label": "When did it start?", "required": false, "style": "short" }
        ]
      },
      {
        "id": "billing",
        "name": "Billing and Purchases",
        "description": "Questions about purchases or payments",
        "emoji": "🧾",
        "parentCategoryId": "",
        "logsChannelId": "",
        "supportRoleIds": [],
        "requiredRoleIds": [],
        "questions": [
          { "label": "Describe the issue. Do not include card details or passwords.", "required": true, "style": "paragraph" }
        ]
      }
    ]
