    { "id": "low", "label": "Low", "rank": 1, "emoji": "🟢" },
    { "id": "normal", "label": "Normal", "rank": 2, "emoji": "🔵" },
    { "id": "high", "label": "High", "rank": 3, "emoji": "🟠" },
    { "id": "urgent", "label": "Urgent", "rank": 4, "emoji": "🔴" }
